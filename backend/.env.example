# Backend — never commit actual secrets
HF_TOKEN=your_huggingface_token_here

# Hugging Face is the free default provider.
IMAGE_PROVIDER=huggingface
IMAGE_OUTPUT_SIZE=512

# Token pool (optional). Tokens from one account share that account's GPU quota.
# HF_TOKENS=token1,token2,token3

# Optional paid provider using the same Qwen camera-angle model.
# Enable explicitly and configure your own fal account key; never expose it in VITE_*.
# IMAGE_PROVIDER=fal
# FAL_KEY=your_fal_key_here

# Override the public Spaces with your own deployment if desired.
# HF_SPACE=your-account/your-camera-space
